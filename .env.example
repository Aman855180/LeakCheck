# Environment Configuration (Template)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & Authentication
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=leakcheck
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/leakcheck

# CORS & Frontend Origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Deterministic Fixed Reconciliation Baseline
DEFAULT_AS_OF_DATE=2026-11-01

# AI Fallback Column Mapping (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

